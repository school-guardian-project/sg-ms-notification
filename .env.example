ConnectionStrings__DefaultConnection=Server=sqlserver;Database=school-guardian;User Id={user};Password={password};TrustServerCertificate=True;Pooling=True;Min Pool Size=2;Max Pool Size=40;Connection Timeout=15;ConnectRetryCount=1;ConnectRetryInterval=10;MultipleActiveResultSets=False

Kafka__BootstrapServers=kafka:9092

# Validacion local del access token RS256 de ms-iam (JWKS).
Jwt__Issuer=
Jwt__Audience=
Jwt__JwksUrl=

# Secreto HMAC propio de este servicio para firmar/validar las credenciales QR.
Qr__Secret={qr-hmac-secret}
Qr__TtlSeconds=120

# gRPC interno (h2c). Los clientes estan en ms-route y ms-user-management.
Grpc__Route__Address=http://ms-route:5001
Grpc__Family__Address=http://ms-user-management:5001

# Endpoint de Expo Push usado por el consumidor de student.scanned.
Expo__PushEndpoint={expo-push-endpoint}
